{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "@playwright/test"
    ],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "strict": false
  },
  "include": [
    "playwright.config.ts",
    "tests/**/*.ts",
    "src/**/*.js",
    "src/**/*.vue"
  ]
}